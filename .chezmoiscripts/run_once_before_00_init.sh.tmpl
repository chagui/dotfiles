#!/bin/bash
set -eufo pipefail

# XDG Base Directory defaults — strict mode (set -u) would otherwise fail
# on a fresh shell where these aren't yet exported. Matches the pattern in
# run_once_after_10_install_python_toolchains.sh.
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"

mkdir -p "$XDG_DATA_HOME/zsh/completions"

# shellcheck disable=1054,1083
{{- if eq .chezmoi.os "darwin" }}
# Install Homebrew if not already installed
if ! command -v brew &> /dev/null; then
    echo "🍺  Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Install packages from embedded Brewfile
echo "Installing packages from Brewfile..."
brew bundle --file=/dev/stdin <<EOF
tap "1password/tap"
tap "derailed/k9s"
tap "hashicorp/tap"
tap "romkatv/powerlevel10k"
tap "terraform-docs/tap"
tap "withered-magic/brew"
tap "withgraphite/tap"
brew "openssl@3"
brew "readline"
brew "sqlite"
brew "xz"
brew "ansible"
brew "ansible-lint"
brew "lz4"
brew "zstd"
brew "git"
brew "aws-vault"
brew "awscli"
brew "bash"
brew "bazelisk"
brew "buf"
brew "buildifier"
brew "buildozer"
brew "cdk8s"
brew "chezmoi"
brew "cmake"
brew "coreutils"
brew "crane"
brew "curl"
brew "dive"
brew "ffmpeg"
brew "fzf"
brew "gcc"
brew "gh"
brew "gimme"
brew "git-absorb"
brew "git-lfs"
brew "git-machete"
brew "gitlab-runner"
brew "glab"
brew "gnu-sed"
brew "gnu-tar"
brew "gnupg"
brew "go"
brew "golangci-lint"
brew "gperftools"
brew "graphviz"
brew "gron"
brew "grpcurl"
brew "helm"
brew "hey"
brew "httpie"
brew "hugo"
brew "hyperfine"
brew "imagemagick"
brew "jemalloc"
brew "jless"
brew "jnv"
brew "jq"
brew "jsonnet"
brew "kind"
brew "ko"
brew "kubernetes-cli"
brew "kubectx"
brew "kubie"
brew "lazygit"
brew "libpq"
brew "librdkafka"
brew "licenseplist"
brew "lima"
brew "llvm"
brew "lsd"
brew "luarocks"
brew "make"
brew "most"
brew "fastfetch"
brew "neovim"
brew "ollama"
brew "parallel"
brew "pgcli"
brew "pinentry-mac"
brew "powerlevel10k"
brew "pre-commit"
brew "procs"
brew "protobuf"
brew "python-tabulate"
brew "rbenv"
brew "redis"
brew "ruff"
brew "scc"
brew "shellcheck"
brew "shfmt"
brew "speedtest-cli"
brew "svg2png"
brew "telnet"
brew "terraform-ls"
brew "terraform_landscape"
brew "terraformer"
brew "tfenv"
brew "tgenv"
brew "tmux"
brew "tree-sitter"
# The CLI is a separate formula; nvim-treesitter's main branch needs it to
# compile parsers (`tree-sitter build`).
brew "tree-sitter-cli"
brew "toilet"
brew "watch"
brew "wget"
brew "xcodes"
brew "xq"
brew "yamllint"
brew "ykman"
brew "yq"
brew "zellij"
brew "zlib"
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-history-substring-search"
brew "zsh-syntax-highlighting"
brew "gitmux"
brew "derailed/k9s/k9s", trusted: true
brew "hashicorp/tap/packer", trusted: true
brew "terraform-docs/tap/terraform-docs", trusted: true
brew "withered-magic/brew/starpls", trusted: true
brew "withgraphite/tap/graphite", trusted: true
cask "1password-cli"
# The Alacritty cask is disabled by Homebrew's Gatekeeper policy.
cask "aws-vault-binary"
cask "betterdisplay"
cask "brave-browser"
cask "finicky"
cask "firefox"
cask "itsycal"
cask "meld"
cask "netnewswire"
cask "obsidian"
cask "stats"
cask "sublime-text"
cask "vanilla"
cask "vlc"
EOF

# The upstream Homebrew formula uses syntax removed in Homebrew 7. Install
# the official release archive instead (https://tart.run/quick-start/).
# Keep the app bundle intact so macOS can find its provisioning profile.
if ! command -v tart &>/dev/null; then
    echo "📦  Installing Tart"
    mkdir -p "$XDG_DATA_HOME/tart" "$HOME/.local/bin"
    curl -fsSL https://github.com/cirruslabs/tart/releases/latest/download/tart.tar.gz \
        | tar -xz -C "$XDG_DATA_HOME/tart"
    cat > "$HOME/.local/bin/tart" <<'TART'
#!/bin/sh
exec "${XDG_DATA_HOME:-$HOME/.local/share}/tart/tart.app/Contents/MacOS/tart" "$@"
TART
    chmod +x "$HOME/.local/bin/tart"
fi

echo "Package installation completed."


# shellcheck disable=1054,1083
{{ end -}}

# shellcheck disable=1054,1083
{{- if eq .chezmoi.os "linux" }}
# The cargo binstall compile fallback needs a C linker. It is hit on arm64,
# where some crates (e.g. dns-doge) publish no aarch64 prebuilt.
if ! command -v cc &>/dev/null; then
    echo "📦  Installing build-essential"
    sudo apt-get update -qq
    sudo apt-get install -y -qq build-essential
fi

# shellcheck disable=1054,1083
{{ end -}}

# All platforms: bootstrap Rust toolchain so `cargo binstall` has a compile
# fallback when no prebuilt binary exists for the host target.
# CI's fake home must get its own rustup environment even if cargo is on PATH.
if ! command -v cargo &>/dev/null || [ ! -r "$HOME/.cargo/env" ]; then
    echo "🦀  Installing Rust toolchain"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- --default-toolchain stable --no-modify-path -y
fi
# shellcheck disable=SC1091
source "$HOME/.cargo/env"

if ! command -v cargo-binstall &>/dev/null; then
    echo "📦  Installing cargo-binstall"
    curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
        | bash
fi

# Rust CLIs mirrored across macOS and Linux. cargo-binstall pulls the upstream
# prebuilt binary when available and falls back to `cargo install` from source
# via the default `compile` strategy.
echo "📦  Installing Rust CLIs via cargo binstall"
cargo binstall --locked --no-confirm \
    bat \
    broot \
    dns-doge \
    du-dust \
    eza \
    fd-find \
    git-delta \
    ripgrep \
    tealdeer \
    topgrade \
    zoxide

# shellcheck disable=1054,1083
{{- if eq .chezmoi.os "linux" }}
# Refresh apt indices once. Bootstraps on fresh systems (CI runners,
# cleaned containers) often have stale or missing /var/lib/apt/lists.
if ! command -v rsync &>/dev/null || ! command -v unzip &>/dev/null; then
    sudo apt-get update -qq
fi

# rsync ships on macOS but not on minimal Linux images.
if ! command -v rsync &>/dev/null; then
    echo "📦  Installing rsync"
    sudo apt-get install -y -qq rsync
fi

if ! command -v unzip &>/dev/null; then
    echo "📦  Installing unzip"
    sudo apt-get install -y -qq unzip
fi

# Upstream release tarballs name architectures differently: neovim uses
# x86_64/arm64, fzf uses Go's amd64/arm64 (same as .chezmoi.arch).
NVIM_ARCH={{ if eq .chezmoi.arch "arm64" }}arm64{{ else }}x86_64{{ end }}
FZF_ARCH={{ .chezmoi.arch }}

# neovim: apt versions on Debian/Ubuntu lag far behind what the lazy.nvim
# config requires, so pull the upstream stable tarball into ~/.local.
# Probe with --version rather than `command -v` so a binary for the wrong
# architecture (left by an earlier x86_64-only bootstrap) gets replaced.
if ! nvim --version &>/dev/null; then
    echo "📦  Installing neovim"
    mkdir -p "$HOME/.local"
    curl -fsSL "https://github.com/neovim/neovim/releases/download/stable/nvim-linux-${NVIM_ARCH}.tar.gz" \
        | tar -xz -C "$HOME/.local" --strip-components=1
fi

# fzf is Go (not on crates.io); fetch the upstream release into ~/.local/bin.
# The version is pinned rather than looked up via the GitHub API, which needs
# $GITHUB_TOKEN to avoid rate limits; fresh machines have no credentials yet.
FZF_VERSION=0.74.5
if ! fzf --version &>/dev/null; then
    echo "📦  Installing fzf"
    mkdir -p "$HOME/.local/bin"
    curl -fsSL "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_${FZF_ARCH}.tar.gz" \
        | tar -xz -C "$HOME/.local/bin"
fi



# shellcheck disable=1054,1083
{{ end -}}
